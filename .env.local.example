# Google Calendar Integration
# Copy this file to .env.local and fill in your values.
# These variables are server-side only — never prefix with NEXT_PUBLIC_.

# Your Google Calendar ID (found in Google Calendar settings → "Integrate calendar")
# Example: abc123xyz@group.calendar.google.com
GOOGLE_CALENDAR_ID=

# Your Google API Key (created in Google Cloud Console with Calendar API enabled)
# Restrict the key to the Calendar API and your domain for security.
GOOGLE_API_KEY=
